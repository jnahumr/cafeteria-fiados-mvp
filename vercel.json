{
  "redirects": [
    { "source": "/app", "missing": [{ "type": "cookie", "key": "sesion" }], "destination": "/login", "permanent": false },
    { "source": "/app/:path*", "missing": [{ "type": "cookie", "key": "sesion" }], "destination": "/login", "permanent": false },
    { "source": "/admin", "missing": [{ "type": "cookie", "key": "sesion" }], "destination": "/login", "permanent": false }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
